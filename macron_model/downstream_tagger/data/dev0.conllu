# absolute_id = 1871
# doc_id = urn:cts:greekLit:tlg0014.tlg047.perseus-grc1
# sent_id = 152
# text = ταῦτα δέ μου λέγοντος καὶ διαμαρτυρομένου , κακά με πολλὰ εἰπόντες ὁ μὲν Θεόφημος ἠκολούθει μόλις , διατριβὰς ἐμποιῶν καὶ φάσκων βούλεσθαι καὶ αὐτός τινας παραλαβεῖν μάρτυρας ( ταῦτα δʼ ἔλεγεν τεχνάζων τοῦ χρόνον ἐγγενέσθαι ) , ὁ δʼ Εὔεργος οὑτοσὶ εὐθὺς ἐκ τῆς πόλεως μεθʼ ἑτέρων ὁμοίων αὑτῷ ἐλθὼν εἰς ἀγρόν , τὰ ὑπόλοιπα σκεύη , εἴ τινα τῇ προτεραίᾳ ἐν τῷ πύργῳ ἦν καὶ οὐκ ἔτυχεν ἔξω ὄντα , ἐπειδὴ δʼ ἐγὼ ἦλθον , διὰ τὴν χρείαν κατηνέχθη , ἐκβαλὼν τὴν θύραν ἥνπερ καὶ τῇ προτεραίᾳ ἐξέβαλον κακῶς ἐνεστηκυῖαν , ᾤχετό μου λαβὼν τὰ σκεύη ·
